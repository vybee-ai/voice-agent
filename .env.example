# ===== Application mode =====
# "demo" uses realistic built-in Dubai demo data so the app is always presentable.
# "live" reads from the Google Sheet using the credentials below.
APP_MODE=demo

# ===== Google Sheets (source of truth for live mode) =====
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ===== WhatsApp provider =====
# "twilio" or "meta"
WHATSAPP_PROVIDER=twilio
WHATSAPP_NUMBER=+9715XXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# ===== Voice provider (existing AI qualification workflow) =====
VOICE_PROVIDER=twilio
VOICE_PHONE_NUMBER=+9715XXXXXXX
VOICE_AGENT_NAME=Sofia
VOICE_RECORDING_ENABLED=true
VOICE_TRANSCRIPT_ENABLED=true

# ===== Market defaults (used to seed Settings > Company) =====
MARKET_COUNTRY="United Arab Emirates"
MARKET_CITY="Dubai"
MARKET_CURRENCY="AED"
MARKET_PHONE_CODE="+971"
MARKET_TIMEZONE="Asia/Dubai"

# ===== Vapi Web SDK — /talk-to-sofia client-facing page =====
# These must be prefixed with NEXT_PUBLIC_ so Next.js exposes them to browser code.
# NEXT_PUBLIC_VAPI_PUBLIC_KEY is your Vapi PUBLIC key (safe to expose — not the private API key).
# NEXT_PUBLIC_VAPI_ASSISTANT_ID is the UUID of the Sofia assistant in the Vapi dashboard.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# ===== n8n Webhook Automations =====
# Webhook triggered when a new lead is submitted on the web / API
N8N_NEW_LEAD_WEBHOOK_URL=https://vybee.app.n8n.cloud/webhook/onex/new-lead
# Webhook configured in Vapi Dashboard -> Server URL (fires on end-of-call-report)
N8N_CALL_COMPLETED_WEBHOOK_URL=https://vybee.app.n8n.cloud/webhook/onex/vapi/call-completed
